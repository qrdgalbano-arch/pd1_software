# Application mode
APP_ENVIRONMENT=production
DEBUG=false

# PostgreSQL credentials and database
POSTGRES_DB=qmmc_pd1
POSTGRES_USER=qmmc_user
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password

# Database URL used by the backend container
DATABASE_URL=postgresql+psycopg://qmmc_user:replace_with_a_long_unique_database_password@db:5432/qmmc_pd1

# JWT configuration
JWT_SECRET_KEY=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the API directly.
# Set to the deployed HTTPS dashboard origin; separate multiple values with commas.
CORS_ORIGINS=https://dashboard.example.com

# Host headers accepted by the backend behind Nginx.
# Separate multiple DNS names with commas.
TRUSTED_HOSTS=dashboard.example.com,localhost,127.0.0.1
