# Application mode
APP_ENVIRONMENT=development
DEBUG=false

# PostgreSQL database configuration
POSTGRES_DB=qmmc_pd1
POSTGRES_USER=qmmc_user
POSTGRES_PASSWORD=change_this_password

# Backend database connection
DATABASE_URL=postgresql+psycopg://qmmc_user:change_this_password@db:5432/qmmc_pd1

# JWT authentication configuration
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed frontend origins during local development
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://10.0.2.2:8000

# Host headers accepted during local development
TRUSTED_HOSTS=localhost,127.0.0.1
