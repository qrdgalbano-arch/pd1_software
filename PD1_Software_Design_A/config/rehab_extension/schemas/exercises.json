{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "ptnum": {"type": ["number", "null"], "description": "PT_SET: null until supplied and approved by the PT."},
    "approval": {"type": "object", "properties": {"approved": {"type": "boolean"}, "approved_by": {"type": ["string", "null"]}, "approved_at": {"type": ["string", "null"]}, "approved_config_sha256": {"type": ["string", "null"]}}, "required": ["approved", "approved_by", "approved_at", "approved_config_sha256"], "additionalProperties": false},
    "protocol": {"type": "object", "properties": {"range_min_deg": {"$ref": "#/$defs/ptnum"}, "range_max_deg": {"$ref": "#/$defs/ptnum"}, "target_deg": {"$ref": "#/$defs/ptnum"}, "target_tolerance_deg": {"$ref": "#/$defs/ptnum"}, "redness_full_scale_deg": {"$ref": "#/$defs/ptnum"}}, "required": ["range_min_deg", "range_max_deg", "target_deg", "target_tolerance_deg", "redness_full_scale_deg"], "additionalProperties": false},
    "repetition": {"type": "object", "properties": {"start_threshold_deg": {"$ref": "#/$defs/ptnum"}, "return_threshold_deg": {"$ref": "#/$defs/ptnum"}, "minimum_duration_seconds": {"$ref": "#/$defs/ptnum"}, "required_hold_seconds": {"$ref": "#/$defs/ptnum"}}, "required": ["start_threshold_deg", "return_threshold_deg", "minimum_duration_seconds", "required_hold_seconds"], "additionalProperties": false},
    "joint": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "target_deg": {"type": ["number", "null"]}, "tolerance_deg": {"$ref": "#/$defs/ptnum"}, "redness_full_scale_deg": {"$ref": "#/$defs/ptnum"}, "pt_confirmation_required": {"type": "boolean"}}, "required": ["enabled", "target_deg", "tolerance_deg", "redness_full_scale_deg", "pt_confirmation_required"], "additionalProperties": false}
  },
  "properties": {
    "config_version": {"type": "string"},
    "exercises": {
      "type": "object",
      "properties": {
        "ankle_pumps": {"type": "object", "properties": {"moving_joint": {"type": "string"}, "testing_position": {"type": "string"}, "approval": {"$ref": "#/$defs/approval"}, "moving_joint_protocol": {"$ref": "#/$defs/protocol"}, "repetition": {"$ref": "#/$defs/repetition"}, "assessment": {"type": "object", "properties": {"reference_override_deg": {"$ref": "#/$defs/ptnum"}, "wnl_tolerance_deg": {"$ref": "#/$defs/ptnum"}, "slr_expected_arom_deg": {"$ref": "#/$defs/ptnum"}, "directional_expected_arom_deg": {"type": "object", "properties": {"dorsiflexion": {"$ref": "#/$defs/ptnum"}, "plantarflexion": {"$ref": "#/$defs/ptnum"}}, "required": ["dorsiflexion", "plantarflexion"], "additionalProperties": false}}, "required": ["reference_override_deg", "wnl_tolerance_deg", "slr_expected_arom_deg", "directional_expected_arom_deg"], "additionalProperties": false}, "supporting_joints": {"type": "object", "properties": {"hip": {"$ref": "#/$defs/joint"}, "knee": {"$ref": "#/$defs/joint"}}, "required": ["hip", "knee"], "additionalProperties": false}, "directional_endpoints_deg": {"type": "object", "properties": {"dorsiflexion": {"$ref": "#/$defs/ptnum"}, "plantarflexion_magnitude": {"$ref": "#/$defs/ptnum"}}, "required": ["dorsiflexion", "plantarflexion_magnitude"], "additionalProperties": false}, "assess_directions_separately": {"type": "boolean"}}, "required": ["moving_joint", "testing_position", "approval", "moving_joint_protocol", "repetition", "assessment", "supporting_joints", "directional_endpoints_deg", "assess_directions_separately"], "additionalProperties": false},
        "straight_leg_raise": {"type": "object", "properties": {"moving_joint": {"type": "string"}, "testing_position": {"type": "string"}, "approval": {"$ref": "#/$defs/approval"}, "moving_joint_protocol": {"$ref": "#/$defs/protocol"}, "repetition": {"$ref": "#/$defs/repetition"}, "assessment": {"type": "object", "properties": {"reference_override_deg": {"$ref": "#/$defs/ptnum"}, "wnl_tolerance_deg": {"$ref": "#/$defs/ptnum"}, "slr_expected_arom_deg": {"$ref": "#/$defs/ptnum"}}, "required": ["reference_override_deg", "wnl_tolerance_deg", "slr_expected_arom_deg"], "additionalProperties": false}, "supporting_joints": {"type": "object", "properties": {"knee": {"$ref": "#/$defs/joint"}, "ankle": {"$ref": "#/$defs/joint"}}, "required": ["knee", "ankle"], "additionalProperties": false}}, "required": ["moving_joint", "testing_position", "approval", "moving_joint_protocol", "repetition", "assessment", "supporting_joints"], "additionalProperties": false},
        "prone_knee_flexion": {"type": "object", "properties": {"moving_joint": {"type": "string"}, "testing_position": {"type": "string"}, "approval": {"$ref": "#/$defs/approval"}, "moving_joint_protocol": {"$ref": "#/$defs/protocol"}, "repetition": {"$ref": "#/$defs/repetition"}, "assessment": {"type": "object", "properties": {"reference_override_deg": {"$ref": "#/$defs/ptnum"}, "wnl_tolerance_deg": {"$ref": "#/$defs/ptnum"}, "expected_arom_deg": {"$ref": "#/$defs/ptnum"}}, "required": ["reference_override_deg", "wnl_tolerance_deg", "expected_arom_deg"], "additionalProperties": false}, "supporting_joints": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}}, "required": ["moving_joint", "testing_position", "approval", "moving_joint_protocol", "repetition", "assessment", "supporting_joints"], "additionalProperties": false}
      },
      "required": ["ankle_pumps", "straight_leg_raise", "prone_knee_flexion"],
      "additionalProperties": false
    }
  },
  "required": ["config_version", "exercises"],
  "additionalProperties": false
}
