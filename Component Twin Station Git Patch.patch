@@ -0,0 +1,28 @@
+:root { --bg:#0f1720; --panel:#17212c; --text:#f3f6f9; --muted:#9fb0c0; --ok:#3fbf5f; --warn:#f0b429; --err:#ef4444; --info:#3b82f6; }
+* { box-sizing: border-box; }
+body { margin:0; font-family: system-ui, "Segoe UI", Ubuntu, sans-serif; background:var(--bg); color:var(--text); font-size:18px; }
+header { display:flex; justify-content:space-between; align-items:center; padding:12px 20px; background:#0b1118; }
+h1 { font-size:24px; margin:0; } h2 { font-size:20px; margin:0 0 8px; } h3 { font-size:17px; margin:16px 0 6px; color:var(--muted); }
+#status-bar span { margin-left:16px; color:var(--muted); }
+#controls { display:flex; flex-wrap:wrap; gap:12px; align-items:end; padding:12px 20px; }
+label { display:flex; flex-direction:column; gap:4px; color:var(--muted); font-size:15px; }
+label.check { flex-direction:row; align-items:center; }
+select, button { font-size:18px; padding:10px 14px; border-radius:8px; border:1px solid #2c3b4a; background:#0b1118; color:var(--text); min-height:48px; }
+button { cursor:pointer; } button.primary { background:var(--info); border-color:var(--info); } button.danger { background:var(--err); border-color:var(--err); }
+button:disabled { opacity:.45; cursor:not-allowed; }
+.prompt { margin:0 20px; padding:16px 20px; border-radius:10px; font-size:28px; font-weight:700; }
+.prompt.info { background:#1e3a5f; } .prompt.success { background:#14532d; } .prompt.warning { background:#713f12; } .prompt.error { background:#7f1d1d; }
+main { display:grid; grid-template-columns: 1.2fr 1fr 0.9fr; gap:16px; padding:16px 20px; }
+.panel { background:var(--panel); border-radius:12px; padding:14px; min-width:0; } .panel.wide { margin:0 20px 20px; }
+#camera { width:100%; border-radius:8px; background:#000; aspect-ratio:16/9; object-fit:contain; }
+#avatar { width:100%; height:420px; border-radius:8px; overflow:hidden; background:#0b1118; }
+#calibration { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:8px; }
+.hint { color:var(--muted); font-size:15px; }
+#counts { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
+.count { border-radius:10px; padding:10px; text-align:center; background:#0b1118; } .count b { display:block; font-size:44px; }
+.count.valid b { color:var(--ok); } .count.invalid b { color:var(--err); } .count.incomplete b { color:var(--warn); }
+.big { font-size:20px; margin:8px 0; }
+table { width:100%; border-collapse:collapse; font-size:16px; } th, td { text-align:left; padding:6px; border-bottom:1px solid #2c3b4a; }
+td.lost { color:var(--muted); } td.dev { color:var(--err); font-weight:700; }
+@media (max-width: 1200px) { main { grid-template-columns:1fr; } }
+#calibration[hidden] { display:none; }
