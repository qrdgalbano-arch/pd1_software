+++ b/backend/scripts/seed_component_twin_demo.py
@@ -0,0 +1,106 @@
+"""Seed the three dirty-prototype exercises, the station staff account,
+and demo prescriptions for the Component Twin exercise station.
+
+Run after scripts.seed_demo_users:
+    docker compose exec backend python -m scripts.seed_component_twin_demo
+"""
+
+import os
+
+from sqlalchemy import select
+
+from app.core.security import hash_password
+from app.database.session import SessionLocal
+from app.models import Exercise, Prescription, User, UserRole
+
+EXERCISES = [
+    {
+        "name": "Straight Leg Raising",
+        "description": (
+            "Lie on your back. Keep the knee straight and lift the leg "
+            "to the prescribed height, then lower it slowly. "
+            "Reference ROM: hip flexion 0-80 degrees."
+        ),
+        "default_repetitions": 10,
+        "default_duration_seconds": 180,
+    },
+    {
+        "name": "Side Leg Lifts",
+        "description": (
+            "Lie on your side. Keep the top leg straight and lift it "
+            "sideways, then lower it slowly. "
+            "Reference ROM: hip abduction 0-45 degrees."
+        ),
+        "default_repetitions": 10,
+        "default_duration_seconds": 180,
+    },
+    {
+        "name": "Prone Leg Flexion",
+        "description": (
+            "Lie on your stomach. Keep the thigh on the mat and bend the "
+            "knee to bring the heel toward the buttocks, then lower it. "
+            "Reference ROM: knee flexion 0-135 degrees."
+        ),
+        "default_repetitions": 10,
+        "default_duration_seconds": 180,
+    },
+]
+
+STATION_EMAIL = os.getenv("STATION_STAFF_EMAIL", "station@example.com")
+STATION_PASSWORD = os.getenv("STATION_STAFF_PASSWORD", "StationDemo123!")
+
+
+def main() -> None:
+    with SessionLocal() as db:
+        patient = db.scalar(select(User).where(User.email == "patient@example.com"))
+        staff = db.scalar(select(User).where(User.email == "staff@example.com"))
+
+        if patient is None or staff is None:
+            raise RuntimeError("Run scripts.seed_demo_users first.")
+
+        station = db.scalar(select(User).where(User.email == STATION_EMAIL))
+        if station is None:
+            station = User(
+                full_name="Component Twin Exercise Station",
+                email=STATION_EMAIL,
+                password_hash=hash_password(STATION_PASSWORD),
+                role=UserRole.staff,
+                is_active=True,
+            )
+            db.add(station)
+            print(f"Created station staff user: {STATION_EMAIL}")
+
+        for item in EXERCISES:
+            exercise = db.scalar(select(Exercise).where(Exercise.name == item["name"]))
+            if exercise is None:
+                exercise = Exercise(**item, is_active=True)
+                db.add(exercise)
+                db.flush()
+                print(f"Created exercise: {exercise.name}")
+
+            prescription = db.scalar(
+                select(Prescription).where(
+                    Prescription.patient_id == patient.id,
+                    Prescription.exercise_id == exercise.id,
+                    Prescription.is_active.is_(True),
+                )
+            )
+            if prescription is None:
+                db.add(
+                    Prescription(
+                        patient_id=patient.id,
+                        staff_id=staff.id,
+                        exercise_id=exercise.id,
+                        repetitions_target=10,
+                        duration_limit_seconds=180,
+                        scheduled_days="Monday, Wednesday, Friday",
+                        is_active=True,
+                    )
+                )
+                print(f"Created prescription: {exercise.name}")
+
+        db.commit()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/backend/tests/test_session_ingestion.py b/backend/tests/test_session_ingestion.py
new file mode 100644
index 0000000..97c4307
--- /dev/null
+++ b/backend/tests/test_session_ingestion.py
@@ -0,0 +1,81 @@
+from app.models import FlagType, StaffFlag
+
+
+def _payload(seeded_data, **overrides):
+    payload = {
+        "client_session_id": "station-test-session-0001",
+        "patient_id": seeded_data["patient"].id,
+        "prescription_id": seeded_data["active_prescription"].id,
+        "status": "completed",
+        "repetitions_completed": 8,
+        "duration_seconds": 95,
+        "error_count": 1,
+        "error_summary": "Keep your knee straight x1",
+        "valid_repetitions": 8,
+        "invalid_repetitions": 1,
+        "incomplete_repetitions": 1,
+        "arom_classification": "Within Normal Limits",
+        "peak_rom_degrees": 78.5,
+        "affected_side": "left",
+        "device_recorded_at": "2026-10-18T01:00:00Z",
+    }
+    payload.update(overrides)
+    return payload
+
+
+def test_station_uploads_session(client, staff_headers, seeded_data):
+    response = client.post(
+        "/staff/sessions", json=_payload(seeded_data), headers=staff_headers
+    )
+    assert response.status_code == 201, response.text
+    body = response.json()
+    assert body["valid_repetitions"] == 8
+    assert body["arom_classification"] == "Within Normal Limits"
+    assert body["prescription"]["exercise"]["name"] == "Seated Knee Extension"
+
+    sessions = client.get(
+        f"/staff/patients/{seeded_data['patient'].id}/sessions",
+        headers=staff_headers,
+    ).json()
+    assert any(s["client_session_id"] == "station-test-session-0001" for s in sessions)
+
+
+def test_station_upload_is_idempotent(client, staff_headers, seeded_data):
+    first = client.post("/staff/sessions", json=_payload(seeded_data), headers=staff_headers)
+    second = client.post("/staff/sessions", json=_payload(seeded_data), headers=staff_headers)
+    assert first.status_code == 201
+    assert second.status_code == 200
+    assert first.json()["id"] == second.json()["id"]
+
+
+def test_station_upload_rejects_other_patients_prescription(client, staff_headers, seeded_data):
+    payload = _payload(seeded_data, patient_id=seeded_data["other_patient"].id)
+    response = client.post("/staff/sessions", json=payload, headers=staff_headers)
+    assert response.status_code == 404
+
+
+def test_station_upload_requires_staff(client, patient_headers, seeded_data):
+    response = client.post("/staff/sessions", json=_payload(seeded_data), headers=patient_headers)
+    assert response.status_code == 403
+
+
+def test_station_upload_creates_compliance_flags(client, staff_headers, seeded_data, db):
+    payload = _payload(
+        seeded_data,
+        client_session_id="station-test-session-0002",
+        status="incomplete",
+        repetitions_completed=2,
+        valid_repetitions=2,
+        invalid_repetitions=3,
+    )
+    response = client.post("/staff/sessions", json=payload, headers=staff_headers)
+    assert response.status_code == 201, response.text
+    types = {flag.flag_type for flag in db.query(StaffFlag).all()}
+    assert FlagType.incomplete_session in types
+    assert FlagType.repeated_error in types
+
+
+def test_station_upload_validates_counts(client, staff_headers, seeded_data):
+    payload = _payload(seeded_data, repetitions_completed=5)
+    response = client.post("/staff/sessions", json=payload, headers=staff_headers)
+    assert response.status_code == 422
