# Copy to station/.env and edit. Never commit station/.env.

# Backend from the main repository (native run: http://localhost:8000,
# or the deployed HTTPS host name such as https://dashboard.example.com)
BACKEND_URL=http://localhost:8000

# Dedicated staff account used by the station to download prescriptions
# and upload session records (created by scripts.seed_component_twin_demo)
STATION_STAFF_EMAIL=station@example.com
STATION_STAFF_PASSWORD=StationDemo123!

# Camera: device index (0, 1, ...) or a path to a test video file
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Local station UI (keep on 127.0.0.1; the camera stream must not leave the PC)
STATION_HOST=127.0.0.1
STATION_PORT=8080

# Seconds between automatic upload attempts of pending session records
SYNC_INTERVAL_SECONDS=30
